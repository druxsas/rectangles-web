{
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["var(--font-display)", "Anton", "Impact", "sans-serif"] },
      "sans":    { "$type": "fontFamily", "$value": ["var(--font-sans)", "Inter", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["var(--font-mono)", "JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 },
      "black":    { "$type": "fontWeight", "$value": 900 }
    },
    "size": {
      "display-xl": { "$type": "string", "$value": "clamp(3rem, 4vw + 2rem, 5.5rem)",   "$description": "Hero: ~48px mobile → ~88px desktop (fluid)" },
      "display-lg": { "$type": "string", "$value": "clamp(2.5rem, 3vw + 1.5rem, 4rem)", "$description": "~40px → 64px (brandbook display, fluid)" },
      "display-md": { "$type": "string", "$value": "clamp(2rem, 2vw + 1.25rem, 3rem)",  "$description": "~32px → 48px (fluid)" },
      "heading-lg": { "$type": "string", "$value": "2rem",     "$description": "32px — brandbook heading" },
      "heading-md": { "$type": "string", "$value": "1.5rem",   "$description": "24px — brandbook subheading" },
      "heading-sm": { "$type": "string", "$value": "1.25rem" },
      "body-lg":    { "$type": "string", "$value": "1.125rem" },
      "body-md":    { "$type": "string", "$value": "1rem",     "$description": "16px — brandbook body" },
      "body-sm":    { "$type": "string", "$value": "0.875rem", "$description": "14px — brandbook auxiliary" },
      "mono-sm":    { "$type": "string", "$value": "0.75rem" }
    },
    "line-height": {
      "display": { "$type": "number", "$value": 0.9,  "$description": "Very tight for display headings (brandbook display)" },
      "heading": { "$type": "number", "$value": 1.15 },
      "body":    { "$type": "number", "$value": 1.5,  "$description": "Standard readability" },
      "tight":   { "$type": "number", "$value": 1.2 }
    },
    "letter-spacing": {
      "tight":  { "$type": "dimension", "$value": "-0.02em" },
      "normal": { "$type": "dimension", "$value": "0" },
      "wide":   { "$type": "dimension", "$value": "0.05em" },
      "caps":   { "$type": "dimension", "$value": "0.1em", "$description": "For uppercase labels (R / 01 • SKATE)" }
    }
  }
}
